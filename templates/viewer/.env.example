# Cirro API base. Standalone: the tenant API URL. Dev with proxy: /api
VITE_CIRRO_API=/api
# Tenant to proxy to in development (only used by vite.config.ts)
# Replace with your Cirro tenant's address
CIRRO_PROXY_TARGET=https://your-tenant.example
# Client ID of the registered Public App. Leave empty for embedded-only viewers.
VITE_CIRRO_CLIENT_ID=
