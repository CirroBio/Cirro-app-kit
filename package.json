{
  "name": "@cirrobio/app-kit",
  "version": "0.1.0",
  "private": true,
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "bin": {
    "cirro-app": "bin/cirro-app.mjs"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist .rollup.cache tsconfig.tsbuildinfo",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@cirrobio/api-client": "^0.13.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.5",
    "eslint": "9.39.4",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.59.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@cirrobio/api-client": "^0.13.0"
  }
}
